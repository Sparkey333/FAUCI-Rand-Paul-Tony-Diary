{
  "$comment": "Single source of truth. The BYOK tab and the Feature Parity tab both render from this file — add a provider here and it appears in both. Every keyUrl is checked by scripts/check-links.py, which CI runs.",
  "schemaVersion": 1,
  "lastReviewed": "2026-08-01",
  "capabilityKeys": {
    "streaming": "Token-by-token streaming responses",
    "tools": "Tool / function calling",
    "vision": "Image input",
    "structured": "Enforced JSON / schema-constrained output",
    "embeddings": "Embedding endpoint on the same key",
    "caching": "Prompt caching",
    "reasoning": "Extended / visible reasoning modes"
  },
  "categories": [
    {
      "id": "commercial",
      "label": "Commercial",
      "blurb": "First-party paid APIs. Key is billed to your account."
    },
    {
      "id": "cloud",
      "label": "Cloud platform",
      "blurb": "Models via a cloud provider. Uses platform IAM rather than a simple API key."
    },
    {
      "id": "aggregator",
      "label": "Aggregator & open-model hosts",
      "blurb": "One key, many models — including open weights."
    },
    {
      "id": "media",
      "label": "Media generation",
      "blurb": "Image, video, audio, and 3D generation."
    },
    {
      "id": "local",
      "label": "Local & self-hosted",
      "blurb": "Runs on your own hardware. No key leaves the machine."
    }
  ],
