{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Provenance",
  "version": "0.1.0",
  "identifier": "io.github.sparkey333.provenance",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Provenance",
        "width": 940,
        "height": 760,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Licensed under Apache-2.0",
    "category": "Utility",
    "shortDescription": "Seal and verify documents of contested provenance.",
    "longDescription": "Seals a folder to a Merkle root so that any later edit is detectable, and keeps a ledger of who claimed what. Sealing proves only that bytes have not changed since sealing; it does not establish that a document is authentic.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
